<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>INI-CET Nov 2026 Stream Overlay</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Google Fonts: Inter & Outfit -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Outfit:wght@500;600;700;800&display=swap" rel="stylesheet">
    <!-- FontAwesome for crisp modern icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                        display: ['Outfit', 'sans-serif'],
                    },
                    colors: {
                        pearl: {
                            50: '#ffffff',
                            100: '#fdfbfb',
                            200: '#f4f4f6',
                            800: '#1e293b',
                            900: '#0f172a',
                        },
                        accent: {
                            blue: '#2563eb',
                            indigo: '#4f46e5',
                            emerald: '#059669',
                            amber: '#d97706',
                            rose: '#e11d48',
                        }
                    }
                }
            }
        }
    </script>

    <style>
        /* Base 16:9 Stream Canvas styling */
        body, html {
            margin: 0;
            padding: 0;
            width: 100vw;
            height: 100vh;
            overflow: hidden;
            background-color: transparent;
            font-family: 'Inter', sans-serif;
            user-select: none;
        }

        /* 16:9 Aspect ratio container shell */
        .stream-canvas {
            position: relative;
            width: 100vw;
            height: 56.25vw; /* 16:9 ratio */
            max-height: 100vh;
            max-width: 177.78vh; /* 16:9 ratio */
            margin: auto;
            top: 0; bottom: 0; left: 0; right: 0;
        }

        /* Pearl White Glassmorphism Card Effect */
        .pearl-glass {
            background: rgba(253, 251, 251, 0.90);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border: 1px solid rgba(255, 255, 255, 0.8);
            box-shadow: 0 10px 30px -5px rgba(0, 0, 0, 0.12), 
                        0 4px 12px -2px rgba(0, 0, 0, 0.08),
                        inset 0 1px 1px 0 rgba(255, 255, 255, 0.9);
            border-radius: 1.25rem;
        }

        /* Subtle glow pulse for active study block */
        @keyframes activePulse {
            0%, 100% { box-shadow: 0 0 0 2px rgba(37, 99, 235, 0.4), 0 4px 15px rgba(37, 99, 235, 0.2); }
            50% { box-shadow: 0 0 0 4px rgba(37, 99, 235, 0.7), 0 6px 20px rgba(37, 99, 235, 0.35); }
        }

        .active-session-card {
            background: linear-gradient(135deg, rgba(239, 246, 255, 0.98), rgba(219, 234, 254, 0.95)) !important;
            border: 1.5px solid #3b82f6 !important;
            animation: activePulse 2.5s infinite ease-in-out;
        }

        /* Smooth SVG progress ring rotation */
        .progress-ring__circle {
            transition: stroke-dashoffset 0.35s;
            transform: rotate(-90deg);
            transform-origin: 50% 50%;
        }

        /* Fake webcam toggle helper for testing layout without OBS */
        .simulated-cam-bg {
            background: linear-gradient(rgba(15, 23, 42, 0.6), rgba(15, 23, 42, 0.6)), 
                        url('https://images.unsplash.com/photo-1516321318423-f06f85e504b3?q=80&w=1920&auto=format&fit=crop') center/cover;
        }

        /* 95% Camera Output Blur Filter Layer */
        .camera-blur-overlay {
            position: absolute;
            inset: 0;
            backdrop-filter: blur(25px) contrast(98%) brightness(0.98);
            -webkit-backdrop-filter: blur(25px) contrast(98%) brightness(0.98);
            background: rgba(255, 255, 255, 0.15);
            pointer-events: none;
            z-index: -1;
            transition: opacity 0.3s ease;
            opacity: 0.95;
        }

        /* Scrollbar custom styling */
        ::-webkit-scrollbar { width: 4px; }
        ::-webkit-scrollbar-thumb { background: rgba(0,0,0,0.15); border-radius: 4px; }
    </style>
</head>
<body class="flex items-center justify-center min-h-screen">

    <!-- MAIN 16:9 STREAM OVERLAY CONTAINER -->
    <div id="canvasContainer" class="stream-canvas p-6 flex flex-col justify-between pointer-events-none transition-all duration-300 relative">
        
        <!-- 95% Camera Backdrop Blur Layer -->
        <div id="cameraBlurLayer" class="camera-blur-overlay opacity-95"></div>

        <!-- ================= TOP SECTION ================= -->
        <div class="w-full flex justify-between items-start pointer-events-auto">
            
            <!-- TOP LEFT: TARGET EXAM TITLE BADGE -->
            <div class="pearl-glass px-5 py-3 flex items-center space-x-3">
                <div class="w-10 h-10 rounded-xl bg-blue-600 flex items-center justify-center text-white font-bold shadow-md shadow-blue-500/30">
                    <i class="fa-solid fa-user-doctor text-lg"></i>
                </div>
                <div>
                    <div class="text-xs font-bold tracking-wider text-blue-600 uppercase">Target Exam</div>
                    <div class="text-xl font-black font-display text-slate-800 tracking-tight leading-tight flex items-center gap-2">
                        <span>INI-CET</span>
                        <span class="bg-blue-100 text-blue-700 text-xs px-2 py-0.5 rounded-md border border-blue-200 font-extrabold">NOV 2026</span>
                    </div>
                </div>
            </div>

            <!-- TOP CENTER: COUNTDOWN WIDGET FOR INI-CET NOV 2026 -->
            <div class="pearl-glass px-6 py-3 flex items-center space-x-6">
                <div class="flex items-center space-x-2 border-r border-slate-200/80 pr-4">
                    <span class="relative flex h-3 w-3">
                      <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-rose-400 opacity-75"></span>
                      <span class="relative inline-flex rounded-full h-3 w-3 bg-rose-500"></span>
                    </span>
                    <div class="flex flex-col">
                        <span class="text-xs font-extrabold uppercase tracking-wider text-slate-800">INI-CET NOV 2026</span>
                        <span class="text-[10px] font-bold uppercase tracking-widest text-slate-400">Countdown</span>
                    </div>
                </div>
                
                <div class="flex items-center space-x-4 text-center">
                    <div>
                        <div id="cdDays" class="text-2xl font-black font-display text-slate-800 leading-none">000</div>
                        <div class="text-[10px] font-bold text-slate-400 uppercase mt-1">Days</div>
                    </div>
                    <span class="text-slate-300 font-light text-xl">:</span>
                    <div>
                        <div id="cdHours" class="text-2xl font-black font-display text-slate-800 leading-none">00</div>
                        <div class="text-[10px] font-bold text-slate-400 uppercase mt-1">Hours</div>
                    </div>
                    <span class="text-slate-300 font-light text-xl">:</span>
                    <div>
                        <div id="cdMins" class="text-2xl font-black font-display text-slate-800 leading-none">00</div>
                        <div class="text-[10px] font-bold text-slate-400 uppercase mt-1">Mins</div>
                    </div>
                    <span class="text-slate-300 font-light text-xl">:</span>
                    <div>
                        <div id="cdSecs" class="text-2xl font-black font-display font-mono text-blue-600 leading-none w-8">00</div>
                        <div class="text-[10px] font-bold text-slate-400 uppercase mt-1">Secs</div>
                    </div>
                </div>
            </div>

            <!-- TOP RIGHT: LIVE STREAM STATUS BADGE -->
            <div class="pearl-glass px-4 py-3 flex items-center space-x-3">
                <div class="flex items-center space-x-2">
                    <span class="h-2.5 w-2.5 rounded-full bg-emerald-500 animate-pulse"></span>
                    <span class="text-xs font-bold text-slate-700 tracking-wide uppercase">Live Session</span>
                </div>
                <div class="h-4 w-[1px] bg-slate-300"></div>
                <div id="currentTimeISTBadge" class="text-xs font-mono font-bold text-slate-600">--:-- IST</div>
            </div>
        </div>

        <!-- ================= CENTER & SIDEBAR LAYOUT ================= -->
        <!-- Center area is completely transparent for camera video output -->
        <div class="flex-1 my-4 flex justify-between items-center pointer-events-none">
            
            <!-- LEFT SIDEBAR: ANALOG CLOCK (1x1) & POMODORO TIMER (1x1) -->
            <div class="w-72 flex flex-col space-y-4 pointer-events-auto">
                
                <!-- 1x1 ASPECT RATIO WIDGET 1: ANALOG CLOCK + DATE -->
                <div class="pearl-glass aspect-square p-4 flex flex-col justify-between items-center relative overflow-hidden">
                    <!-- Widget Header -->
                    <div class="w-full flex justify-between items-center text-xs font-semibold text-slate-500">
                        <span class="flex items-center space-x-1.5"><i class="fa-regular fa-clock text-blue-600"></i> <span>IST TIME</span></span>
                        <span id="digitalTimeSmall" class="font-mono font-bold text-slate-700">00:00:00</span>
                    </div>

                    <!-- Modern Analog Clock Face -->
                    <div class="relative w-32 h-32 my-1 flex items-center justify-center">
                        <svg class="w-full h-full drop-shadow-sm" viewBox="0 0 100 100">
                            <!-- Clock Face Background -->
                            <circle cx="50" cy="50" r="46" fill="#f8fafc" stroke="#e2e8f0" stroke-width="2"/>
                            
                            <!-- Clock Ticks -->
                            <g stroke="#94a3b8" stroke-linecap="round">
                                <line x1="50" y1="8" x2="50" y2="12" stroke-width="2"/>
                                <line x1="50" y1="88" x2="50" y2="92" stroke-width="2"/>
                                <line x1="8" y1="50" x2="12" y2="50" stroke-width="2"/>
                                <line x1="88" y1="50" x2="92" y2="50" stroke-width="2"/>
                            </g>
                            
                            <!-- Sub Ticks -->
                            <g stroke="#cbd5e1" stroke-linecap="round" stroke-width="1">
                                <line x1="71" y1="13.6" x2="69" y2="17.1"/>
                                <line x1="86.4" y1="29" x2="82.9" y2="31"/>
                                <line x1="86.4" y1="71" x2="82.9" y2="69"/>
                                <line x1="71" y1="86.4" x2="69" y2="82.9"/>
                                <line x1="29" y1="86.4" x2="31" y2="82.9"/>
                                <line x1="13.6" y1="71" x2="17.1" y2="69"/>
                                <line x1="13.6" y1="29" x2="17.1" y2="31"/>
                                <line x1="29" y1="13.6" x2="31" y2="17.1"/>
                            </g>

                            <!-- Hour Hand -->
                            <line id="analogHour" x1="50" y1="50" x2="50" y2="28" stroke="#1e293b" stroke-width="3.5" stroke-linecap="round" />
                            <!-- Minute Hand -->
                            <line id="analogMin" x1="50" y1="50" x2="50" y2="18" stroke="#3b82f6" stroke-width="2.5" stroke-linecap="round" />
                            <!-- Second Hand -->
                            <line id="analogSec" x1="50" y1="50" x2="50" y2="14" stroke="#ef4444" stroke-width="1.5" stroke-linecap="round" />
                            <!-- Center Pivot Pin -->
                            <circle cx="50" cy="50" r="3" fill="#1e293b"/>
                            <circle cx="50" cy="50" r="1" fill="#ffffff"/>
                        </svg>
                    </div>

                    <!-- Date Badge -->
                    <div class="w-full text-center bg-slate-100/80 rounded-lg py-1.5 border border-slate-200/60">
                        <div id="dateDayOfWeek" class="text-[11px] font-black tracking-wider text-blue-600 uppercase">SUNDAY</div>
                        <div id="fullDateText" class="text-xs font-bold text-slate-700">01 NOVEMBER 2026</div>
                    </div>
                </div>

                <!-- 1x1 ASPECT RATIO WIDGET 2: POMODORO TIMER (60 WORK / 5 BREAK) -->
                <div class="pearl-glass aspect-square p-4 flex flex-col justify-between items-center relative">
                    <!-- Pomodoro Header & Status Pill -->
                    <div class="w-full flex justify-between items-center">
                        <span class="text-xs font-extrabold tracking-wider text-slate-600 flex items-center space-x-1.5">
                            <i class="fa-solid fa-hourglass-half text-amber-500"></i>
                            <span>POMODORO</span>
                        </span>
                        <span id="pomoStateBadge" class="text-[10px] font-black uppercase px-2 py-0.5 rounded-full bg-blue-100 text-blue-700 border border-blue-300">
                            FOCUS (60:5)
                        </span>
                    </div>

                    <!-- Circular Progress Timer Ring -->
                    <div class="relative w-32 h-32 my-1 flex items-center justify-center">
                        <svg class="w-full h-full">
                            <!-- Background Circle -->
                            <circle cx="64" cy="64" r="54" stroke="#e2e8f0" stroke-width="8" fill="none" />
                            <!-- Progress Ring Circle -->
                            <circle id="pomoProgressRing" class="progress-ring__circle" cx="64" cy="64" r="54" 
                                    stroke="#2563eb" stroke-width="8" stroke-dasharray="339.29" stroke-dashoffset="0" 
                                    stroke-linecap="round" fill="none" />
                        </svg>
                        
                        <!-- Center Digital Count -->
                        <div class="absolute flex flex-col items-center justify-center text-center">
                            <span id="pomoTimerDisplay" class="text-2xl font-black font-mono text-slate-800 leading-none">60:00</span>
                            <span id="pomoSubtext" class="text-[10px] font-bold text-slate-400 uppercase mt-1">Study Phase</span>
                        </div>
                    </div>

                    <!-- Auto Sync & Mode Control Bar -->
                    <div class="w-full flex items-center justify-between text-[11px] bg-slate-100/80 rounded-lg p-1 border border-slate-200/60">
                        <span class="text-slate-500 font-medium pl-1"><i class="fa-solid fa-rotate text-xs text-blue-500 mr-1"></i>Auto Loop</span>
                        <div class="flex space-x-1">
                            <button id="btnPomoPause" onclick="togglePomodoroPause()" class="px-2 py-0.5 rounded bg-white font-bold text-slate-700 shadow-sm border border-slate-200 hover:bg-slate-50 transition">
                                <i class="fa-solid fa-pause text-[10px]" id="pomoPauseIcon"></i>
                            </button>
                            <button onclick="resetPomodoro()" class="px-2 py-0.5 rounded bg-white font-bold text-slate-700 shadow-sm border border-slate-200 hover:bg-slate-50 transition">
                                <i class="fa-solid fa-rotate-right text-[10px]"></i>
                            </button>
                        </div>
                    </div>
                </div>

            </div>

            <!-- RIGHT SIDEBAR: DAILY SCHEDULE TRACKER (2x4 GRID FORMAT) -->
            <div class="w-80 pointer-events-auto">
                <div class="pearl-glass p-4 flex flex-col h-full">
                    
                    <!-- Schedule Header -->
                    <div class="flex items-center justify-between border-b border-slate-200/80 pb-2 mb-3">
                        <div class="flex items-center space-x-2">
                            <div class="w-7 h-7 rounded-lg bg-indigo-600 flex items-center justify-center text-white text-xs font-bold shadow-sm">
                                <i class="fa-solid fa-calendar-days"></i>
                            </div>
                            <div>
                                <h3 class="text-sm font-extrabold text-slate-800 font-display leading-tight">Daily Schedule</h3>
                                <p class="text-[10px] text-slate-500 font-medium">7:00 AM – 11:00 PM IST</p>
                            </div>
                        </div>
                        <span id="scheduleStatusPill" class="text-[10px] font-bold px-2 py-0.5 rounded-full bg-emerald-100 text-emerald-700 border border-emerald-300">
                            LIVE SYNC
                        </span>
                    </div>

                    <!-- 2x4 GRID CONTAINER FOR 8 SESSIONS & BREAKS -->
                    <div class="grid grid-cols-2 gap-2 text-xs" id="scheduleGrid">
                        
                        <!-- BLOCK 1: Morning Session 1 -->
                        <div id="block-1" class="session-card bg-white/90 p-2.5 rounded-xl border border-slate-200/80 transition-all">
                            <div class="flex justify-between items-center mb-1">
                                <span class="text-[10px] font-bold text-blue-600 uppercase">Session 1</span>
                                <i class="fa-solid fa-book-open text-[10px] text-slate-400"></i>
                            </div>
                            <div class="font-bold text-slate-800 text-[11px] leading-tight">Morning Work</div>
                            <div class="text-[10px] font-mono font-semibold text-slate-500 mt-1">07:00 – 13:30</div>
                        </div>

                        <!-- BLOCK 2: Lunch Break -->
                        <div id="block-2" class="session-card bg-amber-50/80 p-2.5 rounded-xl border border-amber-200/80 transition-all">
                            <div class="flex justify-between items-center mb-1">
                                <span class="text-[10px] font-bold text-amber-600 uppercase">Break</span>
                                <i class="fa-solid fa-utensils text-[10px] text-amber-500"></i>
                            </div>
                            <div class="font-bold text-slate-800 text-[11px] leading-tight">Lunch Break</div>
                            <div class="text-[10px] font-mono font-semibold text-amber-700 mt-1">13:30 – 14:30</div>
                        </div>

                        <!-- BLOCK 3: Afternoon Study -->
                        <div id="block-3" class="session-card bg-white/90 p-2.5 rounded-xl border border-slate-200/80 transition-all">
                            <div class="flex justify-between items-center mb-1">
                                <span class="text-[10px] font-bold text-blue-600 uppercase">Session 2</span>
                                <i class="fa-solid fa-brain text-[10px] text-slate-400"></i>
                            </div>
                            <div class="font-bold text-slate-800 text-[11px] leading-tight">Afternoon Prep</div>
                            <div class="text-[10px] font-mono font-semibold text-slate-500 mt-1">14:30 – 18:00</div>
                        </div>

                        <!-- BLOCK 4: Evening Break -->
                        <div id="block-4" class="session-card bg-amber-50/80 p-2.5 rounded-xl border border-amber-200/80 transition-all">
                            <div class="flex justify-between items-center mb-1">
                                <span class="text-[10px] font-bold text-amber-600 uppercase">Break</span>
                                <i class="fa-solid fa-mug-hot text-[10px] text-amber-500"></i>
                            </div>
                            <div class="font-bold text-slate-800 text-[11px] leading-tight">Tea Break</div>
                            <div class="text-[10px] font-mono font-semibold text-amber-700 mt-1">18:00 – 18:30</div>
                        </div>

                        <!-- BLOCK 5: Evening Session -->
                        <div id="block-5" class="session-card bg-white/90 p-2.5 rounded-xl border border-slate-200/80 transition-all">
                            <div class="flex justify-between items-center mb-1">
                                <span class="text-[10px] font-bold text-blue-600 uppercase">Session 3</span>
                                <i class="fa-solid fa-laptop-code text-[10px] text-slate-400"></i>
                            </div>
                            <div class="font-bold text-slate-800 text-[11px] leading-tight">Evening Focus</div>
                            <div class="text-[10px] font-mono font-semibold text-slate-500 mt-1">18:30 – 20:30</div>
                        </div>

                        <!-- BLOCK 6: Dinner Break -->
                        <div id="block-6" class="session-card bg-amber-50/80 p-2.5 rounded-xl border border-amber-200/80 transition-all">
                            <div class="flex justify-between items-center mb-1">
                                <span class="text-[10px] font-bold text-amber-600 uppercase">Break</span>
                                <i class="fa-solid fa-bowl-food text-[10px] text-amber-500"></i>
                            </div>
                            <div class="font-bold text-slate-800 text-[11px] leading-tight">Dinner Break</div>
                            <div class="text-[10px] font-mono font-semibold text-amber-700 mt-1">20:30 – 21:30</div>
                        </div>

                        <!-- BLOCK 7: Night Final Sprint -->
                        <div id="block-7" class="session-card bg-white/90 p-2.5 rounded-xl border border-slate-200/80 transition-all">
                            <div class="flex justify-between items-center mb-1">
                                <span class="text-[10px] font-bold text-indigo-600 uppercase">Session 4</span>
                                <i class="fa-solid fa-moon text-[10px] text-slate-400"></i>
                            </div>
                            <div class="font-bold text-slate-800 text-[11px] leading-tight">Night Revision</div>
                            <div class="text-[10px] font-mono font-semibold text-slate-500 mt-1">21:30 – 23:00</div>
                        </div>

                        <!-- BLOCK 8: Rest / Off-Hours -->
                        <div id="block-8" class="session-card bg-slate-100/90 p-2.5 rounded-xl border border-slate-200/80 transition-all">
                            <div class="flex justify-between items-center mb-1">
                                <span class="text-[10px] font-bold text-slate-500 uppercase">Off-Hours</span>
                                <i class="fa-solid fa-bed text-[10px] text-slate-400"></i>
                            </div>
                            <div class="font-bold text-slate-700 text-[11px] leading-tight">Rest & Sleep</div>
                            <div class="text-[10px] font-mono font-semibold text-slate-500 mt-1">23:00 – 07:00</div>
                        </div>

                    </div>

                    <!-- Current Active Banner Footnote -->
                    <div class="mt-3 bg-blue-50/90 border border-blue-200/70 rounded-lg p-2 flex items-center justify-between text-xs">
                        <span class="text-[11px] font-bold text-slate-600">Current Phase:</span>
                        <span id="activePhaseName" class="font-black text-blue-700 text-xs">Morning Study</span>
                    </div>

                </div>
            </div>

        </div>

        <!-- ================= BOTTOM BANNER ================= -->
        <div class="w-full flex justify-between items-center text-xs pointer-events-auto">
            <!-- Goal & Motivational Quote Pill -->
            <div class="pearl-glass px-4 py-2 flex items-center space-x-2 text-slate-700 font-semibold">
                <i class="fa-solid fa-quote-left text-blue-500 text-xs"></i>
                <span>"Consistency leads to excellence. Stay focused, doctor."</span>
            </div>

            <!-- Audio & OBS Helper Controls (Auto-hides or stays subtle) -->
            <div class="pearl-glass px-3 py-1.5 flex items-center space-x-3 text-slate-600">
                <button onclick="toggleWhiteNoise()" id="btnNoiseToggle" class="flex items-center space-x-1.5 text-xs font-semibold hover:text-blue-600 transition">
                    <i class="fa-solid fa-wind text-teal-600" id="noiseIcon"></i>
                    <span id="noiseText">White Noise: ON</span>
                </button>
                <div class="h-3 w-[1px] bg-slate-300"></div>
                <button onclick="toggleAudioChime()" id="btnAudioToggle" class="flex items-center space-x-1.5 text-xs font-semibold hover:text-blue-600 transition">
                    <i class="fa-solid fa-volume-high text-emerald-600" id="audioIcon"></i>
                    <span id="audioText">Chimes ON</span>
                </button>
                <div class="h-3 w-[1px] bg-slate-300"></div>
                <button onclick="toggleCamBlur()" class="flex items-center space-x-1.5 text-xs font-semibold hover:text-blue-600 transition">
                    <i class="fa-solid fa-eye-slash text-purple-600" id="camBlurIcon"></i>
                    <span id="camBlurText">Cam Blur: 95%</span>
                </button>
                <div class="h-3 w-[1px] bg-slate-300"></div>
                <button onclick="toggleBackgroundPreview()" class="flex items-center space-x-1.5 text-xs font-semibold hover:text-blue-600 transition">
                    <i class="fa-solid fa-image text-indigo-600"></i>
                    <span id="bgPreviewText">Test Cam BG</span>
                </button>
            </div>
        </div>

    </div>

    <script>
        /* ================= STATE MANAGEMENT & CONFIG ================= */
        // Target INI-CET Exam Date: November 1, 2026 09:00 AM IST
        const TARGET_EXAM_DATE = new Date('2026-11-01T09:00:00+05:30').getTime();

        // Pomodoro Config: 60 minutes work, 5 minutes break
        const WORK_DURATION_SEC = 60 * 60; // 3600s
        const BREAK_DURATION_SEC = 5 * 60;   // 300s
        
        let pomoRemainingSec = WORK_DURATION_SEC;
        let pomoIsWorkPhase = true;
        let pomoIsPaused = false;
        let audioEnabled = true;
        let camBlurEnabled = true;

        /* Ambient White Noise Generator State */
        let whiteNoiseNode = null;
        let whiteNoiseGain = null;
        let whiteNoiseAudioCtx = null;
        let whiteNoiseActive = true;

        // Schedule definition array for 24-hour evaluation
        const SCHEDULE_BLOCKS = [
            { id: 'block-1', name: 'Morning Work', startHour: 7, startMin: 0, endHour: 13, endMin: 30, type: 'work' },
            { id: 'block-2', name: 'Lunch Break', startHour: 13, startMin: 30, endHour: 14, endMin: 30, type: 'break' },
            { id: 'block-3', name: 'Afternoon Prep', startHour: 14, startMin: 30, endHour: 18, endMin: 0, type: 'work' },
            { id: 'block-4', name: 'Tea Break', startHour: 18, startMin: 0, endHour: 18, endMin: 30, type: 'break' },
            { id: 'block-5', name: 'Evening Focus', startHour: 18, startMin: 30, endHour: 20, endMin: 30, type: 'work' },
            { id: 'block-6', name: 'Dinner Break', startHour: 20, startMin: 30, endHour: 21, endMin: 30, type: 'break' },
            { id: 'block-7', name: 'Night Revision', startHour: 21, startMin: 30, endHour: 23, endMin: 0, type: 'work' },
            { id: 'block-8', name: 'Rest & Sleep', startHour: 23, startMin: 0, endHour: 7, endMin: 0, type: 'off' }
        ];

        function initWhiteNoise() {
            try {
                const AudioCtx = window.AudioContext || window.webkitAudioContext;
                if (!AudioCtx) return;
                
                if (!whiteNoiseAudioCtx) {
                    whiteNoiseAudioCtx = new AudioCtx();
                }

                if (whiteNoiseAudioCtx.state === 'suspended') {
                    whiteNoiseAudioCtx.resume();
                }

                if (whiteNoiseNode) return;

                // Create 5 seconds loopable pink/soft white noise buffer
                const bufferSize = whiteNoiseAudioCtx.sampleRate * 5;
                const noiseBuffer = whiteNoiseAudioCtx.createBuffer(1, bufferSize, whiteNoiseAudioCtx.sampleRate);
                const output = noiseBuffer.getChannelData(0);
                
                let b0 = 0, b1 = 0, b2 = 0, b3 = 0, b4 = 0, b5 = 0, b6 = 0;
                for (let i = 0; i < bufferSize; i++) {
                    const white = Math.random() * 2 - 1;
                    b0 = 0.99886 * b0 + white * 0.0555179;
                    b1 = 0.99332 * b1 + white * 0.0750759;
                    b2 = 0.96900 * b2 + white * 0.1538520;
                    b3 = 0.86650 * b3 + white * 0.3104856;
                    b4 = 0.55000 * b4 + white * 0.5329522;
                    b5 = -0.7616 * b5 - white * 0.0168980;
                    output[i] = b0 + b1 + b2 + b3 + b4 + b5 + b6 + white * 0.5362;
                    output[i] *= 0.11;
                    b6 = white * 0.115926;
                }

                whiteNoiseNode = whiteNoiseAudioCtx.createBufferSource();
                whiteNoiseNode.buffer = noiseBuffer;
                whiteNoiseNode.loop = true;

                // Gentle low-pass filter for soft study ambience
                const filter = whiteNoiseAudioCtx.createBiquadFilter();
                filter.type = 'lowpass';
                filter.frequency.setValueAtTime(800, whiteNoiseAudioCtx.currentTime);

                whiteNoiseGain = whiteNoiseAudioCtx.createGain();
                whiteNoiseGain.gain.setValueAtTime(0.06, whiteNoiseAudioCtx.currentTime);

                whiteNoiseNode.connect(filter);
                filter.connect(whiteNoiseGain);
                whiteNoiseGain.connect(whiteNoiseAudioCtx.destination);

                whiteNoiseNode.start();
            } catch (e) {
                console.log("White noise auto-play pending interaction:", e);
            }
        }

        function stopWhiteNoise() {
            if (whiteNoiseGain && whiteNoiseAudioCtx) {
                whiteNoiseGain.gain.exponentialRampToValueAtTime(0.0001, whiteNoiseAudioCtx.currentTime + 0.3);
                setTimeout(() => {
                    if (whiteNoiseNode) {
                        try { whiteNoiseNode.stop(); } catch(e){}
                        whiteNoiseNode.disconnect();
                        whiteNoiseNode = null;
                    }
                }, 300);
            }
        }

        function toggleWhiteNoise() {
            whiteNoiseActive = !whiteNoiseActive;
            const icon = document.getElementById('noiseIcon');
            const text = document.getElementById('noiseText');

            if (whiteNoiseActive) {
                initWhiteNoise();
                icon.className = "fa-solid fa-wind text-teal-600";
                text.innerText = "White Noise: ON";
            } else {
                stopWhiteNoise();
                icon.className = "fa-solid fa-wind text-slate-400";
                text.innerText = "White Noise: OFF";
            }
        }

        // Web Audio Synthesizer for pleasant completion chimes
        function playChimeSound(isBreak) {
            if (!audioEnabled) return;
            try {
                const AudioCtx = window.AudioContext || window.webkitAudioContext;
                if (!AudioCtx) return;
                const ctx = new AudioCtx();
                
                const osc = ctx.createOscillator();
                const gain = ctx.createGain();
                
                osc.type = isBreak ? 'sine' : 'triangle';
                osc.frequency.setValueAtTime(isBreak ? 523.25 : 659.25, ctx.currentTime);
                osc.frequency.exponentialRampToValueAtTime(isBreak ? 659.25 : 880, ctx.currentTime + 0.3);
                
                gain.gain.setValueAtTime(0.15, ctx.currentTime);
                gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + 0.8);
                
                osc.connect(gain);
                gain.connect(ctx.destination);
                
                osc.start();
                osc.stop(ctx.currentTime + 0.8);
            } catch (e) {
                console.log("Audio play blocked or unavailable:", e);
            }
        }

        function updateExamCountdown() {
            const now = new Date().getTime();
            const diff = TARGET_EXAM_DATE - now;

            if (diff <= 0) {
                document.getElementById('cdDays').innerText = "000";
                document.getElementById('cdHours').innerText = "00";
                document.getElementById('cdMins').innerText = "00";
                document.getElementById('cdSecs').innerText = "00";
                return;
            }

            const days = Math.floor(diff / (1000 * 60 * 60 * 24));
            const hours = Math.floor((diff % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
            const mins = Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60));
            const secs = Math.floor((diff % (1000 * 60)) / 1000);

            document.getElementById('cdDays').innerText = String(days).padStart(3, '0');
            document.getElementById('cdHours').innerText = String(hours).padStart(2, '0');
            document.getElementById('cdMins').innerText = String(mins).padStart(2, '0');
            document.getElementById('cdSecs').innerText = String(secs).padStart(2, '0');
        }

        function updateAnalogClockAndDate() {
            // Force IST Time offset calculation for consistent live Indian Standard Time display
            const nowUtc = new Date();
            const istOffsetMs = 5.5 * 60 * 60 * 1000;
            const istTime = new Date(nowUtc.getTime() + (nowUtc.getTimezoneOffset() * 60000) + istOffsetMs);

            const hours = istTime.getHours();
            const minutes = istTime.getMinutes();
            const seconds = istTime.getSeconds();

            // Analog Hand Degrees
            const secDeg = (seconds / 60) * 360;
            const minDeg = ((minutes + seconds / 60) / 60) * 360;
            const hourDeg = (((hours % 12) + minutes / 60) / 12) * 360;

            const hourHand = document.getElementById('analogHour');
            const minHand = document.getElementById('analogMin');
            const secHand = document.getElementById('analogSec');

            if (hourHand) hourHand.setAttribute('transform', `rotate(${hourDeg} 50 50)`);
            if (minHand) minHand.setAttribute('transform', `rotate(${minDeg} 50 50)`);
            if (secHand) secHand.setAttribute('transform', `rotate(${secDeg} 50 50)`);

            // Digital Time formatted
            const hStr = String(hours).padStart(2, '0');
            const mStr = String(minutes).padStart(2, '0');
            const sStr = String(seconds).padStart(2, '0');
            
            document.getElementById('digitalTimeSmall').innerText = `${hStr}:${mStr}:${sStr}`;
            document.getElementById('currentTimeISTBadge').innerText = `${hStr}:${mStr} IST`;

            // Date Badge formatting
            const daysOfWeek = ['SUNDAY', 'MONDAY', 'TUESDAY', 'WEDNESDAY', 'THURSDAY', 'FRIDAY', 'SATURDAY'];
            const months = ['JANUARY', 'FEBRUARY', 'MARCH', 'APRIL', 'MAY', 'JUNE', 'JULY', 'AUGUST', 'SEPTEMBER', 'OCTOBER', 'NOVEMBER', 'DECEMBER'];

            document.getElementById('dateDayOfWeek').innerText = daysOfWeek[istTime.getDay()];
            document.getElementById('fullDateText').innerText = `${String(istTime.getDate()).padStart(2, '0')} ${months[istTime.getMonth()]} ${istTime.getFullYear()}`;
            
            // Check active schedule block
            updateScheduleTracking(hours, minutes);
        }

        function updateScheduleTracking(currentHour, currentMin) {
            const currentTotalMin = currentHour * 60 + currentMin;

            SCHEDULE_BLOCKS.forEach(block => {
                const el = document.getElementById(block.id);
                if (!el) return;

                const startTotalMin = block.startHour * 60 + block.startMin;
                let endTotalMin = block.endHour * 60 + block.endMin;

                // Overnight handling for off-hours (23:00 to 07:00)
                let isActive = false;
                if (startTotalMin > endTotalMin) {
                    isActive = currentTotalMin >= startTotalMin || currentTotalMin < endTotalMin;
                } else {
                    isActive = currentTotalMin >= startTotalMin && currentTotalMin < endTotalMin;
                }

                if (isActive) {
                    if (!el.classList.contains('active-session-card')) {
                        el.classList.add('active-session-card');
                    }
                    document.getElementById('activePhaseName').innerText = block.name;
                } else {
                    el.classList.remove('active-session-card');
                }
            });
        }

        function updatePomodoroTimer() {
            if (pomoIsPaused) return;

            pomoRemainingSec--;

            if (pomoRemainingSec <= 0) {
                // Switch phases
                pomoIsWorkPhase = !pomoIsWorkPhase;
                pomoRemainingSec = pomoIsWorkPhase ? WORK_DURATION_SEC : BREAK_DURATION_SEC;
                playChimeSound(!pomoIsWorkPhase);
            }

            // Render Display
            const m = Math.floor(pomoRemainingSec / 60);
            const s = pomoRemainingSec % 60;
            document.getElementById('pomoTimerDisplay').innerText = `${String(m).padStart(2, '0')}:${String(s).padStart(2, '0')}`;

            // Total phase duration for progress ring
            const totalSec = pomoIsWorkPhase ? WORK_DURATION_SEC : BREAK_DURATION_SEC;
            const progressFraction = (totalSec - pomoRemainingSec) / totalSec;
            
            const circle = document.getElementById('pomoProgressRing');
            const circumference = 2 * Math.PI * 54; // r=54 -> ~339.29
            const offset = circumference - (progressFraction * circumference);
            circle.style.strokeDashoffset = offset;

            // UI Styling depending on Focus vs Break
            const badge = document.getElementById('pomoStateBadge');
            const subtext = document.getElementById('pomoSubtext');

            if (pomoIsWorkPhase) {
                badge.innerText = "FOCUS (60:5)";
                badge.className = "text-[10px] font-black uppercase px-2 py-0.5 rounded-full bg-blue-100 text-blue-700 border border-blue-300";
                circle.setAttribute('stroke', '#2563eb');
                subtext.innerText = "Study Phase";
            } else {
                badge.innerText = "BREAK (5 MIN)";
                badge.className = "text-[10px] font-black uppercase px-2 py-0.5 rounded-full bg-emerald-100 text-emerald-700 border border-emerald-300 animate-pulse";
                circle.setAttribute('stroke', '#059669');
                subtext.innerText = "Rest & Stretch";
            }
        }

        function togglePomodoroPause() {
            pomoIsPaused = !pomoIsPaused;
            const icon = document.getElementById('pomoPauseIcon');
            if (pomoIsPaused) {
                icon.className = "fa-solid fa-play text-[10px]";
            } else {
                icon.className = "fa-solid fa-pause text-[10px]";
            }
        }

        function resetPomodoro() {
            pomoIsWorkPhase = true;
            pomoRemainingSec = WORK_DURATION_SEC;
            pomoIsPaused = false;
            document.getElementById('pomoPauseIcon').className = "fa-solid fa-pause text-[10px]";
            updatePomodoroTimer();
        }

        function toggleAudioChime() {
            audioEnabled = !audioEnabled;
            const icon = document.getElementById('audioIcon');
            const text = document.getElementById('audioText');
            if (audioEnabled) {
                icon.className = "fa-solid fa-volume-high text-emerald-600";
                text.innerText = "Sound ON";
            } else {
                icon.className = "fa-solid fa-volume-xmark text-slate-400";
                text.innerText = "Muted";
            }
        }

        function toggleCamBlur() {
            camBlurEnabled = !camBlurEnabled;
            const blurLayer = document.getElementById('cameraBlurLayer');
            const icon = document.getElementById('camBlurIcon');
            const text = document.getElementById('camBlurText');

            if (camBlurEnabled) {
                blurLayer.style.opacity = '0.95';
                icon.className = "fa-solid fa-eye-slash text-purple-600";
                text.innerText = "Cam Blur: 95%";
            } else {
                blurLayer.style.opacity = '0';
                icon.className = "fa-solid fa-eye text-slate-400";
                text.innerText = "Cam Blur: OFF";
            }
        }

        function toggleBackgroundPreview() {
            const body = document.body;
            const txt = document.getElementById('bgPreviewText');
            if (body.classList.contains('simulated-cam-bg')) {
                body.classList.remove('simulated-cam-bg');
                txt.innerText = "Test Cam BG";
            } else {
                body.classList.add('simulated-cam-bg');
                txt.innerText = "Transparent OBS";
            }
        }

        window.onload = function() {
            // Initial call
            updateExamCountdown();
            updateAnalogClockAndDate();
            
            // Auto start ambient white noise generator
            initWhiteNoise();

            // Unlock audio on initial user click if browser policy requires gesture
            document.addEventListener('click', () => {
                if (whiteNoiseActive) initWhiteNoise();
            }, { once: false });

            // Set precise intervals
            setInterval(updateAnalogClockAndDate, 1000);
            setInterval(updateExamCountdown, 1000);
            setInterval(updatePomodoroTimer, 1000);
        };
    </script>
</body>
